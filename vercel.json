{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/api/index.js" },
    { "source": "/log", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
